{
  "exchanges": [
    {
      "name": "andesstay.reservations.dlx",
      "vhost": "/",
      "type": "fanout",
      "durable": true,
      "auto_delete": false,
      "internal": false,
      "arguments": {}
    }
  ],
  "queues": [
    {
      "name": "andesstay.reservations.dlq",
      "vhost": "/",
      "durable": true,
      "auto_delete": false,
      "arguments": {}
    }
  ],
  "bindings": [
    {
      "source": "andesstay.reservations.dlx",
      "vhost": "/",
      "destination": "andesstay.reservations.dlq",
      "destination_type": "queue",
      "routing_key": "",
      "arguments": {}
    }
  ],
  "policies": [
    {
      "vhost": "/",
      "name": "andesstay-reservation-delivery",
      "pattern": "^andesstay\\.(reservations|guest-notifications)$",
      "apply-to": "queues",
      "priority": 10,
      "definition": {
        "dead-letter-exchange": "andesstay.reservations.dlx",
        "message-ttl": 86400000,
        "max-length": 10000
      }
    },
    {
      "vhost": "/",
      "name": "andesstay-quarantine-retention",
      "pattern": "^andesstay\\.reservations\\.dlq$",
      "apply-to": "queues",
      "priority": 10,
      "definition": {
        "message-ttl": 604800000
      }
    }
  ]
}
